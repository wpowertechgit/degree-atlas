{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["university", "degrees"],
  "additionalProperties": false,
  "properties": {
    "university": {"type": "string"},
    "degrees": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "level", "courses"],
        "additionalProperties": false,
        "properties": {
          "name": {"type": "string"},
          "level": {"enum": ["BSc", "MSc", "PhD"]},
          "curriculum_source": {"type": "string", "pattern": "^https?://"},
          "domain": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
          "choices": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "rule"],
              "additionalProperties": false,
              "properties": {
                "name": {"type": "string", "minLength": 1},
                "rule": {"type": "string", "minLength": 1},
                "source": {"type": "string", "pattern": "^https?://"}
              }
            }
          },
          "courses": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["code", "title", "description"],
              "additionalProperties": false,
              "properties": {
                "code": {"type": "string"},
                "title": {"type": "string"},
                "description": {"type": "string"},
                "topics": {"type": "array", "items": {"type": "string"}},
                "prerequisites": {"type": "array", "items": {"type": "string"}},
                "semester": {"type": ["integer", "null"], "minimum": 1},
                "mandatory": {"type": "boolean"},
                "requirement": {
                  "type": "object",
                  "required": ["kind", "source"],
                  "additionalProperties": false,
                  "properties": {
                    "kind": {"enum": ["mandatory", "elective"]},
                    "source": {"type": "string", "pattern": "^https?://"},
                    "group": {"type": "string", "minLength": 1},
          "quote": {"type": "string", "minLength": 3}
                  }
                },
                "url": {"type": "string"}
              }
            }
          }
        }
      }
    }
  }
}
