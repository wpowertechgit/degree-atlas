{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["university", "degrees"],
  "additionalProperties": false,
  "properties": {
    "university": {"type": "string"},
    "degrees": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "level", "courses"],
        "additionalProperties": false,
        "properties": {
          "name": {"type": "string"},
          "level": {"enum": ["BSc", "MSc", "PhD"]},
          "courses": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["code", "title", "description"],
              "additionalProperties": false,
              "properties": {
                "code": {"type": "string"},
                "title": {"type": "string"},
                "description": {"type": "string"},
                "topics": {"type": "array", "items": {"type": "string"}},
                "prerequisites": {"type": "array", "items": {"type": "string"}},
                "semester": {"type": "integer", "minimum": 1},
                "mandatory": {"type": "boolean"},
                "url": {"type": "string"}
              }
            }
          }
        }
      }
    }
  }
}
